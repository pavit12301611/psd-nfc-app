<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add link / text"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp"
        android:text="Type a website link or any text. Links are auto-saved as secure https://"
        android:textColor="#9E9E9E"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/inputPayload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/input_bg"
        android:gravity="top"
        android:hint="https://example.com or any text"
        android:inputType="textMultiLine|textUri"
        android:minLines="3"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/inputTags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/input_bg"
        android:hint="Tags (comma separated) — e.g. site, main"
        android:inputType="text"
        android:padding="14dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/inputOpenLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/input_bg"
        android:hint="Link that opens on the other phone (optional — default: the link itself)"
        android:inputType="textUri"
        android:padding="14dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/btn_white"
        android:text="SAVE &amp; TRANSMIT"
        android:textAllCaps="true"
        android:textColor="#000000"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
