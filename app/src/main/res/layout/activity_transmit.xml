<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="○ PUNCH MODE OFF"
            android:textColor="#9E9E9E"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txCardSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/tile_bg"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:text="No card registered."
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txCompatibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/tile_bg"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:text="Compatibility: unknown."
            android:textColor="#FFD166"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txHceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:text="NFC: --  |  HCE: --"
            android:textColor="#8AD8FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txLastContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Last reader contact: never"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="READER / TAG LOG (NEWEST FIRST)"
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tile_bg"
            android:lineSpacingExtra="2dp"
            android:minLines="6"
            android:padding="12dp"
            android:text="No APDUs yet."
            android:textColor="#B0B0B0"
            android:textIsSelectable="true"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="Empty log after a tap = the reader never opened an HCE/ISO-DEP session; MIFARE Classic and Type-2 readers always look empty here. APDUs with 6A82 / 6D00 = the app was reached but the AID or command was wrong. MIFARE_WRITE / MIFARE_VERIFY lines come from the magic-card writer; TAG_WRITE / TAG_VERIFY from the NTAG sticker writer."
            android:textColor="#777777"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnRefreshLog"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_ghost"
            android:text="REFRESH"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCopyLog"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_ghost"
            android:text="COPY DIAGNOSTICS"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_ghost"
            android:text="CLEAR LOG"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnWriteSticker"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_white"
            android:text="WRITE / EXPORT PHYSICAL CREDENTIAL"
            android:textAllCaps="true"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_ghost"
            android:text="STOP PUNCH MODE"
            android:textAllCaps="true"
            android:textColor="#FF8FAB"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
