<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1020"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/writeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Write exact Aakash NDEF to a real NTAG sticker"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/writeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:text="Ready. Hold a blank NTAG213 / NTAG215 / NTAG216 sticker to the phone after tapping WRITE."
            android:textColor="#8CE99A"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/writeDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:text=""
            android:textColor="#C9D4FF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/writeCardInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/writeNdefPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:text=""
            android:textColor="#FFD166"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/checkLockTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:buttonTint="#FFFFFF"
            android:checked="false"
            android:padding="8dp"
            android:text="Lock sticker read-only after writing (one-way, irreversible). Leave OFF unless you are sure."
            android:textColor="#FFB4A2"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnWriteTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/btn_white"
            android:padding="14dp"
            android:text="WRITE EXACT NDEF TO NTAG STICKER"
            android:textColor="#0B1020"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVerifyTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_ghost"
            android:padding="14dp"
            android:text="VERIFY A WRITTEN STICKER"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnCloseWrite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_ghost"
            android:padding="14dp"
            android:text="CLOSE"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="A written sticker has a DIFFERENT 7-byte UID and NXP originality signature. If the Saharanpur reader checks those, ask the institute to enroll the sticker UID or use the physical card / an authorised Type-2 emulator. The app never records attendance itself."
            android:textColor="#8A94B8"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
